# Conexión que usa la aplicación (en Neon: la cadena "pooled").
DATABASE_URL="postgresql://consultorio:consultorio@localhost:5432/consultorio"
# Conexión directa para migraciones y respaldos (en Neon: la cadena sin "-pooler").
DIRECT_URL="postgresql://consultorio:consultorio@localhost:5432/consultorio"
# Base exclusiva para las pruebas de integración; se borra en cada corrida.
DATABASE_URL_TEST="postgresql://consultorio:consultorio@localhost:5432/consultorio_test"
# Cliente OAuth de Google ("Aplicación web") para exportar a Google Sheets.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="cambiar"
# Clave de 32 bytes en base64 para cifrar el token de Google: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY="cambiar"
# URL pública de la aplicación, sin barra final.
APP_URL="http://localhost:3000"
